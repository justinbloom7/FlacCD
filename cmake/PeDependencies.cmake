# PE inspection runs on the build host; the target binaries are never executed.
# Resolution uses explicit target directories only, including during cross builds.
function(isWindowsSystemDll name result)
   string(TOLOWER "${name}" lower)
   set(systemNames advapi32.dll bcrypt.dll bcryptprimitives.dll cabinet.dll cfgmgr32.dll
       combase.dll comctl32.dll comdlg32.dll crypt32.dll cryptbase.dll dbghelp.dll dnsapi.dll
       dwmapi.dll gdi32.dll gdi32full.dll imm32.dll iphlpapi.dll kernel32.dll kernelbase.dll
       mpr.dll msimg32.dll msvcrt.dll netapi32.dll normaliz.dll ntdll.dll ole32.dll oleaut32.dll
       powrprof.dll profapi.dll propsys.dll psapi.dll rpcrt4.dll secur32.dll setupapi.dll
       shell32.dll shlwapi.dll shcore.dll sspicli.dll ucrtbase.dll user32.dll userenv.dll
       usp10.dll uxtheme.dll version.dll win32u.dll windowscodecs.dll winhttp.dll wininet.dll
       winmm.dll winspool.drv wintrust.dll wldap32.dll ws2_32.dll wtsapi32.dll)
   if(lower IN_LIST systemNames OR lower MATCHES "^(api-ms-win-|ext-ms-win-)[a-z0-9_.-]+\\.dll$")
      set(${result} TRUE PARENT_SCOPE)
   else()
      set(${result} FALSE PARENT_SCOPE)
   endif()
endfunction()

function(readPeImports path importsResult formatResult rawResult)
   if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
      message(FATAL_ERROR "Missing PE binary: ${path}")
   endif()
   file(READ "${path}" signature LIMIT 2 HEX)
   if(NOT signature STREQUAL "4d5a")
      message(FATAL_ERROR "Not a Windows MZ/PE binary: ${path}")
   endif()
   execute_process(COMMAND "${peObjdump}" -p "${path}"
                   RESULT_VARIABLE inspected OUTPUT_VARIABLE raw ERROR_VARIABLE problem)
   if(NOT inspected EQUAL 0)
      message(FATAL_ERROR "PE inspection failed for ${path}: ${problem}")
   endif()
   if(NOT raw MATCHES "file format (pei-[a-zA-Z0-9_-]+)")
      message(FATAL_ERROR "Unsupported PE objdump format for ${path}; use target-capable GNU objdump")
   endif()
   set(format "${CMAKE_MATCH_1}")
   # Do not silently certify DLLs whose delayed imports are not decoded here.
   if(raw MATCHES "Entry d[ \t]+([0-9a-fA-F]+)[ \t]+([0-9a-fA-F]+)[ \t]+Delay Import Directory")
      set(delayAddress "${CMAKE_MATCH_1}")
      set(delaySize "${CMAKE_MATCH_2}")
      if(NOT delayAddress MATCHES "^0+$" OR NOT delaySize MATCHES "^0+$")
         message(FATAL_ERROR "Delay-load imports require additional inspection; refusing incomplete audit: ${path}")
      endif()
   else()
      message(FATAL_ERROR "Cannot inspect PE delay-import directory: ${path}")
   endif()
   string(REGEX MATCHALL "DLL Name:[ \t]*[^\r\n]+" lines "${raw}")
   set(imports "")
   foreach(line IN LISTS lines)
      string(REGEX REPLACE "^DLL Name:[ \t]*" "" name "${line}")
      string(STRIP "${name}" name)
      if(NOT name MATCHES "^[a-zA-Z0-9_.+-]+\\.(dll|DLL|drv|DRV)$")
         message(FATAL_ERROR "Unsafe/unrecognized PE import name '${name}' in ${path}")
      endif()
      string(TOLOWER "${name}" name)
      list(APPEND imports "${name}")
   endforeach()
   # PE export forwarders can introduce DLL loads without an import descriptor.
   string(REGEX MATCHALL "Forwarder RVA -- [^\r\n \t]+" forwarders "${raw}")
   foreach(line IN LISTS forwarders)
      string(REGEX REPLACE "^Forwarder RVA -- " "" value "${line}")
      if(value MATCHES "^([a-zA-Z0-9_+-]+)(\\.[dD][lL][lL])?\\..+$")
         string(TOLOWER "${CMAKE_MATCH_1}.dll" name)
         list(APPEND imports "${name}")
      else()
         message(FATAL_ERROR "Unsupported PE export forwarder ${value} in ${path}")
      endif()
   endforeach()
   list(REMOVE_DUPLICATES imports)
   set(${importsResult} "${imports}" PARENT_SCOPE)
   set(${formatResult} "${format}" PARENT_SCOPE)
   set(${rawResult} "${raw}" PARENT_SCOPE)
endfunction()

function(resolvePeDll name directories result)
   set(matches "")
   foreach(directory IN LISTS directories)
      if(NOT IS_DIRECTORY "${directory}")
         continue()
      endif()
      file(GLOB entries LIST_DIRECTORIES FALSE "${directory}/*")
      foreach(entry IN LISTS entries)
         get_filename_component(base "${entry}" NAME)
         string(TOLOWER "${base}" lower)
         if(lower STREQUAL name)
            file(REAL_PATH "${entry}" real)
            list(APPEND matches "${real}")
         endif()
      endforeach()
   endforeach()
   list(REMOVE_DUPLICATES matches)
   if(NOT matches)
      message(FATAL_ERROR "Unresolved non-system DLL ${name}; set FLACCD_WINDOWS_RUNTIME_DIRS to target DLL directories. Searched: ${directories}")
   endif()
   list(GET matches 0 selected)
   file(SHA256 "${selected}" expectedHash)
   foreach(match IN LISTS matches)
      file(SHA256 "${match}" actualHash)
      if(NOT actualHash STREQUAL expectedHash)
         message(FATAL_ERROR "Conflicting DLL copies for ${name}: ${matches}; use one consistent target toolchain/dependency set")
      endif()
   endforeach()
   set(${result} "${selected}" PARENT_SCOPE)
endfunction()

function(scanPeClosure executables directories reportDirectory dllsResult)
   execute_process(COMMAND "${peObjdump}" --version OUTPUT_VARIABLE version RESULT_VARIABLE toolResult)
   if(NOT toolResult EQUAL 0 OR NOT version MATCHES "GNU objdump")
      message(FATAL_ERROR "Configure FLACCD_WINDOWS_OBJDUMP with GNU objdump supporting target PE binaries")
   endif()
   file(MAKE_DIRECTORY "${reportDirectory}")
   set(queue ${executables} ${extraPeRoots})
   set(visited "")
   set(dlls "")
   set(expectedFormat "")
   set(report "Windows PE import closure (Windows 10/11 system DLLs are not bundled)\n")
   while(queue)
      list(POP_FRONT queue path)
      file(REAL_PATH "${path}" path)
      if(path IN_LIST visited)
         continue()
      endif()
      list(APPEND visited "${path}")
      readPeImports("${path}" imports format raw)
      if(NOT expectedFormat)
         set(expectedFormat "${format}")
      elseif(NOT format STREQUAL expectedFormat)
         message(FATAL_ERROR "PE architecture mismatch: ${path} (${format}, expected ${expectedFormat})")
      endif()
      get_filename_component(base "${path}" NAME)
      file(WRITE "${reportDirectory}/${base}.imports.txt" "${raw}")
      file(SHA256 "${path}" hash)
      string(APPEND report "\n${base} [${format}] SHA256=${hash}\n")
      foreach(name IN LISTS imports)
         isWindowsSystemDll("${name}" system)
         if(system)
            string(APPEND report "  system: ${name}\n")
         else()
            if(name STREQUAL "msys-2.0.dll" OR name STREQUAL "cygwin1.dll")
               message(FATAL_ERROR "Unexpected POSIX emulation dependency ${name}; use a native MinGW/UCRT64 build")
            endif()
            if(path IN_LIST executables)
               if(expectStaticRuntime AND name MATCHES "^(libstdc\\+\\+-6|libgcc_s_[a-z0-9_-]+)\\.dll$")
                  message(FATAL_ERROR "Static GCC/C++ runtime policy not satisfied by ${base}: ${name}")
               endif()
               if(expectStaticPthread AND name STREQUAL "libwinpthread-1.dll")
                  message(FATAL_ERROR "Static winpthreads policy not satisfied by ${base}")
               endif()
            endif()
            resolvePeDll("${name}" "${directories}" resolved)
            string(APPEND report "  bundled: ${name}\n")
            set_property(GLOBAL PROPERTY "flaccdDllPath_${name}" "${resolved}")
            list(APPEND dlls "${name}")
            list(APPEND queue "${resolved}")
         endif()
      endforeach()
   endwhile()
   list(REMOVE_DUPLICATES dlls)
   string(APPEND report "\nAll non-system imports resolved recursively. No target binary was executed.\n")
   file(WRITE "${reportDirectory}/RuntimeDependencies.txt" "${report}")
   set(${dllsResult} "${dlls}" PARENT_SCOPE)
endfunction()
