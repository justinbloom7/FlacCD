# Bounded parsing for the installer's PE delay-import descriptors. Application
# deployment still rejects delayed imports unless explicitly enabled by caller.
function(peNumber offset bytes result)
   math(EXPR end "${offset} + ${bytes}")
   if(offset LESS 0 OR end GREATER peLength)
      message(FATAL_ERROR "Truncated PE delay-import metadata")
   endif()
   file(READ "${path}" data OFFSET ${offset} LIMIT ${bytes} HEX)
   set(value 0)
   math(EXPR last "${bytes} - 1")
   foreach(index RANGE 0 ${last})
      math(EXPR start "${index} * 2")
      string(SUBSTRING "${data}" ${start} 2 byte)
      math(EXPR value "${value} | (0x${byte} << (${index} * 8))")
   endforeach()
   set(${result} "${value}" PARENT_SCOPE)
endfunction()

function(peRva rva result availableResult)
   if(rva LESS peHeaders)
      set(${result} "${rva}" PARENT_SCOPE)
      math(EXPR available "${peHeaders} - ${rva}")
      set(${availableResult} "${available}" PARENT_SCOPE)
      return()
   endif()
   math(EXPR last "${peSections} - 1")
   foreach(index RANGE 0 ${last})
      math(EXPR header "${peSectionTable} + ${index} * 40 + 12")
      peNumber(${header} 4 address)
      math(EXPR header "${header} + 4")
      peNumber(${header} 4 rawSize)
      math(EXPR header "${header} + 4")
      peNumber(${header} 4 rawOffset)
      math(EXPR displacement "${rva} - ${address}")
      if(displacement GREATER_EQUAL 0 AND displacement LESS rawSize)
         math(EXPR offset "${rawOffset} + ${displacement}")
         math(EXPR available "${rawSize} - ${displacement}")
         math(EXPR end "${rawOffset} + ${rawSize}")
         if(end GREATER peLength)
            message(FATAL_ERROR "Truncated PE delay-import section")
         endif()
         set(${result} "${offset}" PARENT_SCOPE)
         set(${availableResult} "${available}" PARENT_SCOPE)
         return()
      endif()
   endforeach()
   message(FATAL_ERROR "Unmapped PE delay-import RVA: ${rva}")
endfunction()

function(readPeDelayImports path result)
   file(SIZE "${path}" peLength)
   peNumber(60 4 peOffset)
   peNumber(${peOffset} 4 signature)
   if(NOT signature EQUAL 17744)
      message(FATAL_ERROR "Invalid PE signature")
   endif()
   math(EXPR offset "${peOffset} + 6")
   peNumber(${offset} 2 peSections)
   if(peSections LESS 1 OR peSections GREATER 96)
      message(FATAL_ERROR "Invalid PE section count")
   endif()
   math(EXPR offset "${peOffset} + 20")
   peNumber(${offset} 2 optionalSize)
   math(EXPR optional "${peOffset} + 24")
   peNumber(${optional} 2 magic)
   if(magic EQUAL 267)
      set(directoryOffset 96)
      math(EXPR offset "${optional} + 28")
      peNumber(${offset} 4 imageBase)
   elseif(magic EQUAL 523)
      set(directoryOffset 112)
   else()
      message(FATAL_ERROR "Unsupported PE optional-header magic")
   endif()
   math(EXPR needed "${directoryOffset} + 14 * 8")
   if(optionalSize LESS needed)
      message(FATAL_ERROR "Missing PE delay-import directory")
   endif()
   math(EXPR offset "${optional} + ${directoryOffset} - 4")
   peNumber(${offset} 4 directories)
   if(directories LESS 14)
      message(FATAL_ERROR "Missing PE delay-import data directory count")
   endif()
   math(EXPR offset "${optional} + 60")
   peNumber(${offset} 4 peHeaders)
   if(peHeaders GREATER peLength)
      message(FATAL_ERROR "Truncated PE headers")
   endif()
   math(EXPR peSectionTable "${optional} + ${optionalSize}")
   math(EXPR offset "${optional} + ${directoryOffset} + 13 * 8")
   peNumber(${offset} 4 directoryRva)
   math(EXPR offset "${offset} + 4")
   peNumber(${offset} 4 directorySize)
   if(directorySize LESS 32 OR directorySize GREATER 4096 OR directoryRva EQUAL 0)
      message(FATAL_ERROR "Invalid PE delay-import directory size/address")
   endif()
   peRva(${directoryRva} directory available)
   if(directorySize GREATER available)
      message(FATAL_ERROR "PE delay-import directory crosses section bounds")
   endif()
   set(imports "")
   set(terminated FALSE)
   math(EXPR last "${directorySize} / 32 - 1")
   foreach(index RANGE 0 ${last})
      math(EXPR descriptor "${directory} + ${index} * 32")
      file(READ "${path}" data OFFSET ${descriptor} LIMIT 32 HEX)
      if(data MATCHES "^0+$")
         set(terminated TRUE)
         break()
      endif()
      peNumber(${descriptor} 4 attributes)
      math(EXPR offset "${descriptor} + 4")
      peNumber(${offset} 4 nameRva)
      if(attributes EQUAL 0 AND magic EQUAL 267)
         math(EXPR nameRva "${nameRva} - ${imageBase}")
      elseif(NOT attributes EQUAL 1)
         message(FATAL_ERROR "Unsupported PE delay-import attributes")
      endif()
      if(nameRva LESS_EQUAL 0)
         message(FATAL_ERROR "Invalid PE delay-import name RVA")
      endif()
      peRva(${nameRva} nameOffset available)
      set(name "")
      set(nameTerminated FALSE)
      foreach(position RANGE 0 255)
         if(position GREATER_EQUAL available)
            break()
         endif()
         math(EXPR offset "${nameOffset} + ${position}")
         peNumber(${offset} 1 byte)
         if(byte EQUAL 0)
            set(nameTerminated TRUE)
            break()
         endif()
         if(byte LESS 33 OR byte GREATER 126)
            message(FATAL_ERROR "Invalid PE delay-import DLL name byte")
         endif()
         string(ASCII ${byte} character)
         string(APPEND name "${character}")
      endforeach()
      if(NOT nameTerminated OR NOT name MATCHES "^[a-zA-Z0-9_.+-]+\\.[dD][lL][lL]$")
         message(FATAL_ERROR "Invalid or unterminated PE delay-import DLL name")
      endif()
      string(TOLOWER "${name}" name)
      list(APPEND imports "${name}")
   endforeach()
   if(NOT terminated)
      message(FATAL_ERROR "Unterminated PE delay-import descriptor table")
   endif()
   list(REMOVE_DUPLICATES imports)
   set(${result} "${imports}" PARENT_SCOPE)
endfunction()
