cmake_minimum_required(VERSION 3.20)
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
   message(FATAL_ERROR "This release driver is for Linux; Windows uses the flaccd-installer target")
endif()
get_filename_component(sourceRoot "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(FLACCD_BUILD_SETTINGS)
   get_filename_component(FLACCD_BUILD_SETTINGS "${FLACCD_BUILD_SETTINGS}" ABSOLUTE)
   file(STRINGS "${FLACCD_BUILD_SETTINGS}" settingsHeader LIMIT_COUNT 1)
   if(NOT settingsHeader STREQUAL "# FlacCD Windows build settings v1")
      message(FATAL_ERROR "Invalid prepared build settings; run scripts/SetupWindowsBuild.sh")
   endif()
   include("${FLACCD_BUILD_SETTINGS}")
endif()
if(NOT FLACCD_RELEASE_ROOT)
   set(FLACCD_RELEASE_ROOT "${sourceRoot}/build-release-windows")
endif()
get_filename_component(FLACCD_RELEASE_ROOT "${FLACCD_RELEASE_ROOT}" ABSOLUTE)
if(FLACCD_RELEASE_ROOT STREQUAL sourceRoot)
   message(FATAL_ERROR "Use an out-of-source FLACCD_RELEASE_ROOT")
endif()
foreach(required FLACCD_LLVM_MINGW_ROOT FLACCD_ISCC FLACCD_WINE_PREFIX)
   if(NOT IS_ABSOLUTE "${${required}}" OR NOT EXISTS "${${required}}")
      message(FATAL_ERROR "Set ${required} to an existing absolute path; see docs/LinuxWindowsRelease.md")
   endif()
endforeach()
find_program(FLACCD_WINE_EXECUTABLE NAMES wine wine64 REQUIRED)
find_program(FLACCD_WINEPATH_EXECUTABLE NAMES winepath REQUIRED)
find_program(ninjaExecutable NAMES ninja ninja-build REQUIRED)
find_program(pkgConfigExecutable NAMES pkg-config REQUIRED)
find_program(FLACCD_WINDOWS_OBJDUMP NAMES objdump REQUIRED)
find_program(ctestExecutable NAMES ctest HINTS "${CMAKE_ROOT}/../bin" REQUIRED)
if(NOT EXISTS "${FLACCD_WINE_PREFIX}/system.reg")
   message(FATAL_ERROR "Initialize the isolated win64 Wine prefix before running the release driver")
endif()
file(STRINGS "${FLACCD_WINE_PREFIX}/system.reg" wineArchitecture REGEX "^#arch=win64$" LIMIT_COUNT 1)
if(NOT wineArchitecture)
   message(FATAL_ERROR "Use an initialized win64 Wine prefix for the x64 Inno compiler")
endif()
file(MAKE_DIRECTORY "${FLACCD_RELEASE_ROOT}")
file(LOCK "${FLACCD_RELEASE_ROOT}/Release.lock" GUARD PROCESS TIMEOUT 60)
file(WRITE "${FLACCD_RELEASE_ROOT}/ReleaseStatus.txt" "INCOMPLETE: this release run has not succeeded. Previous artifacts may remain.\n")
set(logFile "${FLACCD_RELEASE_ROOT}/Release.log")
file(WRITE "${logFile}" "FlacCD Linux-hosted Windows release\n")
function(runReleaseStep)
   string(JOIN " " description ${ARGV})
   message(STATUS "Release step: ${description}")
   execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
   file(APPEND "${logFile}" "\n${description}\n${output}\n${error}\n")
   if(NOT result STREQUAL "0")
      message(FATAL_ERROR "Release step failed (${result}); see ${logFile}\n${error}")
   endif()
endfunction()
runReleaseStep("${FLACCD_LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang++" --version)
runReleaseStep("${FLACCD_WINE_EXECUTABLE}" --version)
runReleaseStep("${FLACCD_WINDOWS_OBJDUMP}" --version)
if(NOT FLACCD_WINDOWS_DEPENDENCY_PREFIX)
   set(FLACCD_WINDOWS_DEPENDENCY_PREFIX "${FLACCD_RELEASE_ROOT}/Dependencies")
   set(buildDependencies TRUE)
endif()
set(toolchain "${sourceRoot}/cmake/toolchains/LlvmMingwUcrt.cmake")
set(crossArguments "-DCMAKE_TOOLCHAIN_FILE=${toolchain}"
                   "-DFLACCD_LLVM_MINGW_ROOT=${FLACCD_LLVM_MINGW_ROOT}"
                   "-DFLACCD_WINDOWS_DEPENDENCY_PREFIX=${FLACCD_WINDOWS_DEPENDENCY_PREFIX}"
                   "-DFLACCD_WINDOWS_OBJDUMP=${FLACCD_WINDOWS_OBJDUMP}")
# An explicit existing prefix is validated by application configuration. Otherwise
# the pinned dependency project builds/updates incrementally in our own tree.
if(buildDependencies OR NOT EXISTS "${FLACCD_WINDOWS_DEPENDENCY_PREFIX}/FlacCDToolchain.txt")
   runReleaseStep("${CMAKE_COMMAND}" -S "${sourceRoot}/dependencies/windows"
      -B "${FLACCD_RELEASE_ROOT}/DependencyBuild" -G Ninja ${crossArguments}
      "-DCMAKE_MAKE_PROGRAM=${ninjaExecutable}"
      "-DFLACCD_FLAC_SOURCE_ARCHIVE=${FLACCD_FLAC_SOURCE_ARCHIVE}")
   runReleaseStep("${CMAKE_COMMAND}" --build "${FLACCD_RELEASE_ROOT}/DependencyBuild" --parallel 4)
endif()
set(buildRoot "${FLACCD_RELEASE_ROOT}/WindowsBuild")
runReleaseStep("${CMAKE_COMMAND}" -S "${sourceRoot}" -B "${buildRoot}" -G Ninja ${crossArguments}
   "-DCMAKE_MAKE_PROGRAM=${ninjaExecutable}" "-DPKG_CONFIG_EXECUTABLE=${pkgConfigExecutable}"
   -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=ON
   "-DFLACCD_ISCC=${FLACCD_ISCC}" "-DFLACCD_WINE_PREFIX=${FLACCD_WINE_PREFIX}"
   "-DFLACCD_WINE_EXECUTABLE=${FLACCD_WINE_EXECUTABLE}"
   "-DFLACCD_WINEPATH_EXECUTABLE=${FLACCD_WINEPATH_EXECUTABLE}")
runReleaseStep("${CMAKE_COMMAND}" --build "${buildRoot}" --parallel 4)
runReleaseStep("${ctestExecutable}" --test-dir "${buildRoot}" -L host --output-on-failure)
runReleaseStep("${CMAKE_COMMAND}" --build "${buildRoot}" --target flaccd-package flaccd-validation flaccd-installer)
include("${buildRoot}/WindowsDeploy-Release.cmake")
set(installer "${buildRoot}/installer/Release/FlacCD-${appVersion}-windows-x64-setup.exe")
if(NOT EXISTS "${installer}")
   message(FATAL_ERROR "Release completed without the expected installer: ${installer}")
endif()
file(READ "${deployBase}/FlacCD/RuntimeDependencies.txt" dependencies)
file(SHA256 "${installer}" digest)
set(report "Installer: ${installer}\nSHA256: ${digest}\nZIP: ${deployBase}/${archiveName}\nDeployment: ${deployBase}/FlacCD\nWindows tests: ${deployBase}/WindowsValidation\nLog: ${logFile}\n\n${dependencies}\nWindows VM integration validation remains required.\n")
file(WRITE "${FLACCD_RELEASE_ROOT}/ReleaseArtifacts.txt" "${report}")
file(WRITE "${FLACCD_RELEASE_ROOT}/ReleaseStatus.txt" "BUILT: installer and deployment audited. Windows VM validation remains required.\n")
message(STATUS "${report}")
message(STATUS "Install this file on Windows: ${installer}")
