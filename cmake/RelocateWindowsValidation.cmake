cmake_minimum_required(VERSION 3.20)
if(NOT CMAKE_HOST_WIN32)
   message(FATAL_ERROR "Relocate and execute these tests on Windows")
endif()
set(WINDOWS_CMAKE "${CMAKE_COMMAND}")
set(WINDOWS_BUILD "${CMAKE_CURRENT_LIST_DIR}")
set(WINDOWS_SOURCE "${CMAKE_CURRENT_LIST_DIR}/source")
configure_file("${WINDOWS_BUILD}/CTestTestfile.cmake.in" "${WINDOWS_BUILD}/CTestTestfile.cmake" @ONLY)
message(STATUS "Run: ctest --test-dir \"${WINDOWS_BUILD}\" --output-on-failure")
