# The executable list comes from the existing deployment configuration; DLLs
# remain owned by its PE closure audit, not by a second installer inventory.
function(validateInstallerPayload directory executables)
   if(NOT IS_DIRECTORY "${directory}" OR IS_SYMLINK "${directory}")
      message(FATAL_ERROR "Invalid installer payload directory")
   endif()
   set(expectedNames "")
   foreach(path IN LISTS executables)
      get_filename_component(name "${path}" NAME)
      string(TOLOWER "${name}" lower)
      list(APPEND expectedNames "${lower}")
      if(NOT EXISTS "${directory}/${name}")
         message(FATAL_ERROR "Missing installer executable: ${name}")
      endif()
   endforeach()
   file(GLOB_RECURSE entries LIST_DIRECTORIES TRUE RELATIVE "${directory}" "${directory}/*")
   foreach(entry IN LISTS entries)
      string(TOLOWER "${entry}" lower)
      if(IS_SYMLINK "${directory}/${entry}")
         message(FATAL_ERROR "Installer payload contains a symlink: ${entry}")
      endif()
      if(lower MATCHES "\\.exe$" AND NOT lower IN_LIST expectedNames)
         message(FATAL_ERROR "Unexpected installer executable: ${entry}")
      endif()
      if(lower MATCHES "\\.(a|lib|obj|o|pdb|sys|cmd|bat|ps1|iss)$" OR lower MATCHES "[/\\\\].*\\.dll$")
         message(FATAL_ERROR "Development/driver/nested runtime file in installer payload: ${entry}")
      endif()
   endforeach()
   if(NOT EXISTS "${directory}/docs/WindowsInstaller.md")
      message(FATAL_ERROR "Installer usage documentation is missing")
   endif()
endfunction()
