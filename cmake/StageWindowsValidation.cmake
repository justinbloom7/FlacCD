cmake_minimum_required(VERSION 3.20)
include("${configFile}")
include("${CMAKE_CURRENT_LIST_DIR}/PeDependencies.cmake")
file(LOCK "${deployBase}/Deployment.lock" GUARD PROCESS TIMEOUT 60)
set(destination "${deployBase}/WindowsValidation")
# No recursive deletion: a failed staging run can be repeated in place.
file(MAKE_DIRECTORY "${destination}")
file(COPY "${sourceRoot}/cmake" "${sourceRoot}/tests" "${sourceRoot}/installer"
     DESTINATION "${destination}/source")
file(COPY ${executables} DESTINATION "${destination}")
file(GLOB dlls "${deployBase}/FlacCD/*.dll")
if(dlls)
   file(COPY ${dlls} DESTINATION "${destination}")
endif()
# Audit test/probe binaries as well as distributed applications.
set(stagedExecutables "")
foreach(executable IN LISTS executables)
   get_filename_component(name "${executable}" NAME)
   list(APPEND stagedExecutables "${destination}/${name}")
endforeach()
scanPeClosure("${stagedExecutables}" "${destination}" "${destination}/imports" closure)
file(READ "${buildRoot}/CTestTestfile.cmake" tests)
# Keep a template: Windows supplies its own CMake and absolute path at relocation.
string(REPLACE "${CMAKE_COMMAND}" "@WINDOWS_CMAKE@" tests "${tests}")
string(REPLACE "${buildRoot}" "@WINDOWS_BUILD@" tests "${tests}")
string(REPLACE "${sourceRoot}" "@WINDOWS_SOURCE@" tests "${tests}")
file(WRITE "${destination}/CTestTestfile.cmake.in" "${tests}")
file(COPY "${sourceRoot}/cmake/RelocateWindowsValidation.cmake" DESTINATION "${destination}")
message(STATUS "Windows validation bundle: ${destination}; relocate on Windows before running CTest")
