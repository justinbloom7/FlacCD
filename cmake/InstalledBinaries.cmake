function(writeInstalledBinaries directory output)
   file(WRITE "${output}" "FlacCD installed binaries v1\n")
   file(GLOB binaries LIST_DIRECTORIES FALSE "${directory}/*")
   foreach(binary IN LISTS binaries)
      get_filename_component(name "${binary}" NAME)
      string(TOLOWER "${name}" lower)
      if(lower MATCHES "\\.(exe|dll)$")
         file(SHA256 "${binary}" digest)
         file(APPEND "${output}" "${name}|${digest}\n")
      endif()
   endforeach()
endfunction()
