# Setup helpers are separate so cache integrity and ownership can be tested
# without downloading or executing the real Windows tool distributions.
function(fetchWindowsBuildArchive name url hash result)
   set(archive "${FLACCD_ARCHIVE_DIRECTORY}/${name}")
   if(EXISTS "${archive}")
      file(SHA256 "${archive}" actualHash)
      if(NOT actualHash STREQUAL hash)
         message(FATAL_ERROR "Cached archive checksum mismatch: ${archive}; replace it with the pinned download")
      endif()
   else()
      message(STATUS "Downloading ${name}")
      file(DOWNLOAD "${url}" "${archive}.partial" EXPECTED_HASH "SHA256=${hash}"
           TLS_VERIFY TRUE TIMEOUT 300 STATUS status)
      list(GET status 0 code)
      if(NOT code EQUAL 0)
         message(FATAL_ERROR "Download failed: ${name}: ${status}")
      endif()
      file(RENAME "${archive}.partial" "${archive}")
   endif()
   set(${result} "${archive}" PARENT_SCOPE)
endfunction()

function(prepareWindowsBuildTool directoryName archiveName url hash result)
   set(destination "${FLACCD_TOOLS_ROOT}/${directoryName}")
   if(EXISTS "${destination}")
      if(IS_SYMLINK "${destination}" OR NOT EXISTS "${destination}/.FlacCD-build-tool")
         message(FATAL_ERROR "Existing tool directory is not managed by setup; preserved: ${destination}. Choose a fresh --tools-dir")
      endif()
      file(READ "${destination}/.FlacCD-build-tool" recorded)
      if(NOT recorded STREQUAL "FlacCD build tool v1\n${hash}\n")
         message(FATAL_ERROR "Tool ownership/version mismatch; preserved: ${destination}")
      endif()
   else()
      fetchWindowsBuildArchive("${archiveName}" "${url}" "${hash}" archive)
      string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef id)
      set(staging "${FLACCD_TOOLS_ROOT}/.extract-${id}")
      file(MAKE_DIRECTORY "${staging}")
      file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${staging}")
      if(NOT IS_DIRECTORY "${staging}/${directoryName}" OR IS_SYMLINK "${staging}/${directoryName}")
         message(FATAL_ERROR "Unexpected archive layout: ${archive}")
      endif()
      file(WRITE "${staging}/${directoryName}/.FlacCD-build-tool" "FlacCD build tool v1\n${hash}\n")
      file(RENAME "${staging}/${directoryName}" "${destination}")
      file(REMOVE_RECURSE "${staging}")
   endif()
   set(${result} "${destination}" PARENT_SCOPE)
endfunction()

function(runWindowsBuildSetup)
   execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 300)
   file(APPEND "${FLACCD_TOOLS_ROOT}/Setup.log" "\n${ARGV}\n${output}\n${error}\n")
   if(NOT result STREQUAL "0")
      message(FATAL_ERROR "Tool setup failed (${result}); see ${FLACCD_TOOLS_ROOT}/Setup.log\n${error}")
   endif()
endfunction()
