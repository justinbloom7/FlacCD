cmake_minimum_required(VERSION 3.20)
if(NOT CMAKE_HOST_WIN32)
   message(FATAL_ERROR "Smoke testing and Inno Setup compilation require Windows")
endif()
if(NOT IS_DIRECTORY "${payloadDirectory}" OR NOT EXISTS "${peObjdump}" OR NOT EXISTS "${iscc}")
   message(FATAL_ERROR "Pass -DpayloadDirectory=<transferred FlacCD> -DpeObjdump=<GNU objdump.exe> -Discc=<ISCC.exe>")
endif()
file(REAL_PATH "${payloadDirectory}" payloadDirectory)
get_filename_component(deployBase "${payloadDirectory}" DIRECTORY)
get_filename_component(payloadName "${payloadDirectory}" NAME)
if(NOT payloadName STREQUAL "FlacCD")
   message(FATAL_ERROR "Keep the transferred deployment directory named FlacCD")
endif()
set(sourceRoot "${CMAKE_CURRENT_LIST_DIR}/..")
include("${sourceRoot}/cmake/ProductMetadata.cmake")
# The version travels with the build, not a separately edited installer value.
file(READ "${payloadDirectory}/BuildVersion.txt" appVersion)
string(STRIP "${appVersion}" appVersion)
set(deployExecutables "")
foreach(name flaccd flaccd-agent flaccd-info flaccd-export flaccd-bin-cue)
   list(APPEND deployExecutables "${payloadDirectory}/${name}.exe")
endforeach()
set(configFile "${deployBase}/TransferredDeployment.cmake")
file(WRITE "${configFile}" "")
foreach(variable peObjdump sourceRoot deployBase deployExecutables)
   file(APPEND "${configFile}" "set(${variable} [==[${${variable}}]==])\n")
endforeach()
include("${sourceRoot}/cmake/CheckWindowsDeployment.cmake")
set(installerOutput "${deployBase}/installer")
include("${sourceRoot}/cmake/BuildWindowsInstaller.cmake")
