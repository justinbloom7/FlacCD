function(configureWindowsMetadata)
   if(NOT WIN32)
      return()
   endif()
   foreach(target flaccd flaccd-agent flaccd-info flaccd-export flaccd-bin-cue)
      if(target STREQUAL "flaccd")
         set(fileDescription "FlacCD audio CD mount utility")
      elseif(target STREQUAL "flaccd-agent")
         set(fileDescription "FlacCD background mount agent")
      elseif(target STREQUAL "flaccd-info")
         set(fileDescription "FlacCD FLAC metadata inspector")
      elseif(target STREQUAL "flaccd-export")
         set(fileDescription "FlacCD CDDA export utility")
      else()
         set(fileDescription "FlacCD BIN/CUE export utility")
      endif()
      set(originalFilename "${target}.exe")
      configure_file("${PROJECT_SOURCE_DIR}/cmake/WindowsVersion.rc.in"
                     "${CMAKE_CURRENT_BINARY_DIR}/${target}Version.rc" @ONLY)
      target_sources(${target} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/${target}Version.rc")
   endforeach()
endfunction()
