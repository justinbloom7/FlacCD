cmake_minimum_required(VERSION 3.20)
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
   message(FATAL_ERROR "Run this setup on Linux to prepare the Windows cross-build")
endif()
get_filename_component(sourceRoot "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT FLACCD_TOOLS_ROOT)
   set(FLACCD_TOOLS_ROOT "${sourceRoot}/build-windows-tools")
endif()
get_filename_component(FLACCD_TOOLS_ROOT "${FLACCD_TOOLS_ROOT}" ABSOLUTE)
if(FLACCD_TOOLS_ROOT STREQUAL sourceRoot)
   message(FATAL_ERROR "Use an out-of-source tools directory")
endif()
if(NOT FLACCD_ARCHIVE_DIRECTORY)
   set(FLACCD_ARCHIVE_DIRECTORY "${FLACCD_TOOLS_ROOT}/Downloads")
endif()
get_filename_component(FLACCD_ARCHIVE_DIRECTORY "${FLACCD_ARCHIVE_DIRECTORY}" ABSOLUTE)
foreach(path "${FLACCD_TOOLS_ROOT}" "${FLACCD_ARCHIVE_DIRECTORY}")
   if(path MATCHES "[;\r\n]" OR path MATCHES "\\]\\]" OR path MATCHES "\\]==\\]")
      message(FATAL_ERROR "Unsupported CMake settings path: ${path}")
   endif()
endforeach()
file(MAKE_DIRECTORY "${FLACCD_TOOLS_ROOT}" "${FLACCD_ARCHIVE_DIRECTORY}")
file(LOCK "${FLACCD_TOOLS_ROOT}/Setup.lock" GUARD PROCESS TIMEOUT 60)
include("${CMAKE_CURRENT_LIST_DIR}/WindowsBuildSetup.cmake")
file(WRITE "${FLACCD_TOOLS_ROOT}/Setup.log" "FlacCD Windows build prerequisite setup\n")
prepareWindowsBuildTool(llvm-mingw-20240619-ucrt-ubuntu-20.04-x86_64
   llvm-mingw-20240619-ucrt-ubuntu-20.04-x86_64.tar.xz
   https://github.com/mstorsjo/llvm-mingw/releases/download/20240619/llvm-mingw-20240619-ucrt-ubuntu-20.04-x86_64.tar.xz
   27d33157cc252c29ad6f777a96a0d94176fea1b534ff09b5071485def143b90e FLACCD_LLVM_MINGW_ROOT)
prepareWindowsBuildTool(wine-10.0-amd64-wow64 wine-10.0-amd64-wow64.tar.xz
   https://github.com/Kron4ek/Wine-Builds/releases/download/10.0/wine-10.0-amd64-wow64.tar.xz
   aeebbbf239e548f0136f1cd72a2e109dd9a572a8f703da3c09fa40d74d5c255f wineRoot)
set(FLACCD_WINE_EXECUTABLE "${wineRoot}/bin/wine")
set(FLACCD_WINEPATH_EXECUTABLE "${wineRoot}/bin/winepath")
runWindowsBuildSetup("${FLACCD_LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang++" --version)
runWindowsBuildSetup("${FLACCD_WINE_EXECUTABLE}" --version)
set(FLACCD_WINE_PREFIX "${FLACCD_TOOLS_ROOT}/WinePrefix-10.0-Inno-7.1.1")
set(owner "FlacCD compiler Wine prefix v1\n")
if(EXISTS "${FLACCD_WINE_PREFIX}")
   if(IS_SYMLINK "${FLACCD_WINE_PREFIX}" OR NOT EXISTS "${FLACCD_WINE_PREFIX}/.FlacCD-build-prefix")
      message(FATAL_ERROR "Unowned Wine prefix preserved: ${FLACCD_WINE_PREFIX}")
   endif()
   file(READ "${FLACCD_WINE_PREFIX}/.FlacCD-build-prefix" recorded)
   if(NOT recorded STREQUAL owner)
      message(FATAL_ERROR "Wine prefix ownership mismatch; preserved")
   endif()
else()
   file(MAKE_DIRECTORY "${FLACCD_WINE_PREFIX}")
   file(WRITE "${FLACCD_WINE_PREFIX}/.FlacCD-build-prefix" "${owner}")
endif()
set(wineCommand "${CMAKE_COMMAND}" -E env --unset=WINESERVER
   "WINEPREFIX=${FLACCD_WINE_PREFIX}" "WINELOADER=${FLACCD_WINE_EXECUTABLE}"
   WINEARCH=win64 WINEDEBUG=-all "WINEDLLOVERRIDES=mscoree,mshtml,winegstreamer=" "${FLACCD_WINE_EXECUTABLE}")
set(FLACCD_ISCC "${FLACCD_WINE_PREFIX}/drive_c/InnoSetup/ISCC.exe")
set(innoHash 8a5a6711c3766a6e5fb74f280ba0e3551e719ce94538d901fdbd1f8f9920b3f0)
set(compilerMarker "${FLACCD_WINE_PREFIX}/.FlacCD-iscc")
set(ready FALSE)
if(EXISTS "${FLACCD_WINE_PREFIX}/system.reg")
   file(STRINGS "${FLACCD_WINE_PREFIX}/system.reg" architecture REGEX "^#arch=win64$" LIMIT_COUNT 1)
   if(NOT architecture)
      message(FATAL_ERROR "Managed compiler prefix is not win64; preserved. Choose a fresh --tools-dir")
   endif()
endif()
if(EXISTS "${FLACCD_ISCC}" AND EXISTS "${compilerMarker}" AND EXISTS "${FLACCD_WINE_PREFIX}/system.reg")
   file(READ "${compilerMarker}" recorded)
   file(SHA256 "${FLACCD_ISCC}" compilerHash)
   if(recorded STREQUAL "${innoHash}\n${compilerHash}\n")
      set(ready TRUE)
   endif()
endif()
if(NOT ready)
   message(STATUS "Initializing isolated Wine compiler prefix: ${FLACCD_WINE_PREFIX}")
   runWindowsBuildSetup(${wineCommand} wineboot -u)
   fetchWindowsBuildArchive(innosetup-7.1.1-x64.exe
      https://github.com/jrsoftware/issrc/releases/download/is-7_1_1/innosetup-7.1.1-x64.exe
      "${innoHash}" innoInstaller)
   message(STATUS "Installing Inno Setup 7.1.1 into the compiler prefix")
   runWindowsBuildSetup(${wineCommand} "${innoInstaller}" /VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP- "/DIR=C:\\InnoSetup")
   if(NOT EXISTS "${FLACCD_ISCC}")
      message(FATAL_ERROR "Inno setup did not create ISCC.exe; see Setup.log")
   endif()
   file(SHA256 "${FLACCD_ISCC}" compilerHash)
   file(WRITE "${compilerMarker}" "${innoHash}\n${compilerHash}\n")
endif()
set(settings "${FLACCD_TOOLS_ROOT}/WindowsBuildSettings.cmake")
if(EXISTS "${settings}")
   file(STRINGS "${settings}" header LIMIT_COUNT 1)
   if(NOT header STREQUAL "# FlacCD Windows build settings v1")
      message(FATAL_ERROR "Unowned settings file preserved: ${settings}")
   endif()
endif()
file(WRITE "${settings}.partial" "# FlacCD Windows build settings v1\n")
foreach(variable FLACCD_LLVM_MINGW_ROOT FLACCD_WINE_EXECUTABLE FLACCD_WINEPATH_EXECUTABLE FLACCD_WINE_PREFIX FLACCD_ISCC)
   file(APPEND "${settings}.partial" "set(${variable} [==[${${variable}}]==])\n")
endforeach()
file(RENAME "${settings}.partial" "${settings}")
message(STATUS "Windows build prerequisites prepared: ${settings}\nRun scripts/BuildWindows.sh --tools-dir \"${FLACCD_TOOLS_ROOT}\"")
