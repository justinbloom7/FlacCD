# Linux-hosted LLVM-MinGW, x86_64 Windows/UCRT only. Use a fresh build tree.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(FLACCD_LLVM_MINGW_ROOT "${FLACCD_LLVM_MINGW_ROOT}" CACHE PATH "Extracted LLVM-MinGW UCRT toolchain")
set(FLACCD_WINDOWS_DEPENDENCY_PREFIX "${FLACCD_WINDOWS_DEPENDENCY_PREFIX}" CACHE PATH "Dependencies built with this toolchain")
if(NOT IS_ABSOLUTE "${FLACCD_LLVM_MINGW_ROOT}")
   message(FATAL_ERROR "Set FLACCD_LLVM_MINGW_ROOT to the absolute LLVM-MinGW UCRT directory")
endif()
set(triple x86_64-w64-mingw32)
foreach(tool clang clang++ windres)
   if(NOT EXISTS "${FLACCD_LLVM_MINGW_ROOT}/bin/${triple}-${tool}")
      message(FATAL_ERROR "Missing LLVM-MinGW tool: ${triple}-${tool}")
   endif()
endforeach()
set(CMAKE_C_COMPILER "${FLACCD_LLVM_MINGW_ROOT}/bin/${triple}-clang")
set(CMAKE_CXX_COMPILER "${FLACCD_LLVM_MINGW_ROOT}/bin/${triple}-clang++")
set(CMAKE_RC_COMPILER "${FLACCD_LLVM_MINGW_ROOT}/bin/${triple}-windres")
set(CMAKE_AR "${FLACCD_LLVM_MINGW_ROOT}/bin/llvm-ar")
set(CMAKE_RANLIB "${FLACCD_LLVM_MINGW_ROOT}/bin/llvm-ranlib")
# The deployment auditor deliberately uses GNU objdump's PE output format.
find_program(FLACCD_WINDOWS_OBJDUMP NAMES objdump NO_CMAKE_FIND_ROOT_PATH REQUIRED)
set(CMAKE_OBJDUMP "${FLACCD_WINDOWS_OBJDUMP}")
set(CMAKE_FIND_ROOT_PATH "${FLACCD_LLVM_MINGW_ROOT}/${triple}")
if(FLACCD_WINDOWS_DEPENDENCY_PREFIX)
   if(NOT IS_ABSOLUTE "${FLACCD_WINDOWS_DEPENDENCY_PREFIX}")
      message(FATAL_ERROR "FLACCD_WINDOWS_DEPENDENCY_PREFIX must be absolute")
   endif()
   list(PREPEND CMAKE_FIND_ROOT_PATH "${FLACCD_WINDOWS_DEPENDENCY_PREFIX}")
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
# pkg-config is a host program with its own search path, independent of CMake.
# Do not let ambient host PKG_CONFIG_PATH or system .pc files leak into linking.
set(ENV{PKG_CONFIG_PATH} "")
set(ENV{PKG_CONFIG_LIBDIR} "${FLACCD_WINDOWS_DEPENDENCY_PREFIX}/lib/pkgconfig")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "")
set(PKG_CONFIG_USE_CMAKE_PREFIX_PATH FALSE CACHE BOOL "Do not add host prefixes to cross pkg-config searches")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES FLACCD_LLVM_MINGW_ROOT
     FLACCD_WINDOWS_DEPENDENCY_PREFIX FLACCD_WINDOWS_OBJDUMP)
