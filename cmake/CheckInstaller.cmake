cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/PeDependencies.cmake")
set(inspectInstallerDelayImports TRUE)
readPeImports("${installer}" imports format raw)
foreach(import IN LISTS imports)
   isWindowsSystemDll("${import}" system)
   if(NOT system)
      message(FATAL_ERROR "Installer bootstrap imports a non-system DLL: ${import}")
   endif()
endforeach()
file(WRITE "${formatFile}" "${format}")
string(JOIN "\n  " importText ${imports})
file(WRITE "${formatFile}.imports" "  ${importText}\n")
