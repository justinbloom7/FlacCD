# Select a real static implementation on MinGW, never a .dll.a import archive.
function(configureFlacDependency)
   add_library(flaccd-flac INTERFACE)
   add_library(flaccd::flac ALIAS flaccd-flac)
   set(flacLinkage shared PARENT_SCOPE)
   set(staticFlacArchive "" PARENT_SCOPE)
   set(FLACCD_PREFER_STATIC_FLAC ON CACHE BOOL "Prefer link-verified static libFLAC on MinGW")
   set(FLACCD_STATIC_FLAC_ARCHIVE "" CACHE FILEPATH "Optional actual libFLAC.a override (not libFLAC.dll.a)")
   set(selected FALSE)
   if(MINGW AND FLACCD_PREFER_STATIC_FLAC)
      set(directories ${FLAC_STATIC_LIBRARY_DIRS} ${FLAC_LIBRARY_DIRS})
      list(REMOVE_DUPLICATES directories)
      set(archive "${FLACCD_STATIC_FLAC_ARCHIVE}")
      if(NOT archive)
         unset(flaccdFlacArchive CACHE)
         find_file(flaccdFlacArchive NAMES libFLAC.a PATHS ${directories} NO_DEFAULT_PATH)
         set(archive "${flaccdFlacArchive}")
      endif()
      if(archive)
         get_filename_component(name "${archive}" NAME)
         if(NOT name STREQUAL "libFLAC.a" OR NOT EXISTS "${archive}")
            message(FATAL_ERROR "FLACCD_STATIC_FLAC_ARCHIVE must name an existing libFLAC.a implementation, not an import library")
         endif()
         add_library(flaccd-flac-static STATIC IMPORTED GLOBAL)
         set_target_properties(flaccd-flac-static PROPERTIES IMPORTED_LOCATION "${archive}"
                               INTERFACE_INCLUDE_DIRECTORIES "${FLAC_INCLUDE_DIRS}"
                               INTERFACE_COMPILE_DEFINITIONS FLAC__NO_DLL)
         # pkg-config --static supplies private dependencies (not just -lFLAC).
         # Prefer exact archives from the same target dependency prefixes. Named
         # fallback libraries remain target-linker inputs, never host discoveries.
         set(dependencies ${FLAC_STATIC_LIBRARIES})
         find_package(Threads REQUIRED)
         foreach(dependency IN LISTS dependencies)
            if(dependency STREQUAL "FLAC")
               continue()
            endif()
            if(dependency STREQUAL "pthread" OR dependency STREQUAL "winpthread")
               continue()
            endif()
            string(MAKE_C_IDENTIFIER "${dependency}" identifier)
            unset(flaccdFlacDependencyArchive CACHE)
            find_file(flaccdFlacDependencyArchive NAMES "lib${dependency}.a" PATHS ${directories} NO_DEFAULT_PATH)
            if(flaccdFlacDependencyArchive)
               if(NOT TARGET flaccd-flac-${identifier})
                  add_library(flaccd-flac-${identifier} STATIC IMPORTED GLOBAL)
                  set_target_properties(flaccd-flac-${identifier} PROPERTIES IMPORTED_LOCATION "${flaccdFlacDependencyArchive}")
               endif()
               target_link_libraries(flaccd-flac-static INTERFACE flaccd-flac-${identifier})
            else()
               target_link_directories(flaccd-flac-static INTERFACE ${directories})
               target_link_libraries(flaccd-flac-static INTERFACE "${dependency}")
            endif()
            unset(flaccdFlacDependencyArchive)
         endforeach()
         # Some FLAC pkg-config versions omit the encoder's private thread
         # dependency. Model it explicitly; keep a shared fallback when needed.
         unset(flaccdFlacThreadArchive CACHE)
         find_file(flaccdFlacThreadArchive NAMES libwinpthread.a libpthread.a PATHS ${directories} NO_DEFAULT_PATH)
         if(NOT flaccdFlacThreadArchive)
            execute_process(COMMAND "${CMAKE_CXX_COMPILER}" -print-file-name=libwinpthread.a
                            OUTPUT_VARIABLE queriedThreads OUTPUT_STRIP_TRAILING_WHITESPACE
                            RESULT_VARIABLE queried)
            if(queried EQUAL 0 AND IS_ABSOLUTE "${queriedThreads}" AND EXISTS "${queriedThreads}")
               set(flaccdFlacThreadArchive "${queriedThreads}")
            endif()
         endif()
         if(flaccdFlacThreadArchive)
            add_library(flaccd-flac-threads STATIC IMPORTED GLOBAL)
            set_target_properties(flaccd-flac-threads PROPERTIES IMPORTED_LOCATION "${flaccdFlacThreadArchive}")
            target_link_libraries(flaccd-flac-static INTERFACE flaccd-flac-threads)
         else()
            target_link_libraries(flaccd-flac-static INTERFACE Threads::Threads)
         endif()
         target_compile_options(flaccd-flac-static INTERFACE ${FLAC_STATIC_CFLAGS_OTHER})
         target_link_options(flaccd-flac-static INTERFACE ${FLAC_STATIC_LDFLAGS_OTHER})
         set(probeSource "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/FlacCDFlacProbe.cpp")
         file(WRITE "${probeSource}" "#include <FLAC/stream_decoder.h>\n#include <FLAC/stream_encoder.h>\n#include <FLAC/metadata.h>\nint main() { auto volatile decode = &FLAC__stream_decoder_process_single; auto volatile open = &FLAC__stream_decoder_init_file; auto volatile encode = &FLAC__stream_encoder_process_interleaved; auto volatile read = &FLAC__metadata_chain_read_with_callbacks; auto* d = FLAC__stream_decoder_new(); auto* e = FLAC__stream_encoder_new(); auto* m = FLAC__metadata_object_new(FLAC__METADATA_TYPE_VORBIS_COMMENT); FLAC__stream_decoder_delete(d); FLAC__stream_encoder_delete(e); FLAC__metadata_object_delete(m); return decode && open && encode && read ? 0 : 1; }\n")
         set(CMAKE_TRY_COMPILE_TARGET_TYPE EXECUTABLE)
         unset(FLACCD_STATIC_FLAC_LINKS CACHE)
         try_compile(FLACCD_STATIC_FLAC_LINKS "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/FlacCDFlacProbe"
                     "${probeSource}"
                     CMAKE_FLAGS -DCMAKE_CXX_STANDARD=20 -DCMAKE_CXX_STANDARD_REQUIRED=ON
                     LINK_LIBRARIES flaccd-flac-static
                     COPY_FILE "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/FlacCDFlacProbe.exe"
                     OUTPUT_VARIABLE probeLog)
         if(FLACCD_STATIC_FLAC_LINKS AND CMAKE_SYSTEM_NAME STREQUAL "Windows")
            set(inspector "${CMAKE_OBJDUMP}")
            if(FLACCD_WINDOWS_OBJDUMP)
               set(inspector "${FLACCD_WINDOWS_OBJDUMP}")
            endif()
            execute_process(COMMAND "${inspector}" -p "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/FlacCDFlacProbe.exe"
                            RESULT_VARIABLE inspected OUTPUT_VARIABLE imports ERROR_VARIABLE inspectionError)
            string(TOLOWER "${imports}" imports)
            if(NOT inspected EQUAL 0 OR NOT imports MATCHES "file format pei-" OR
               imports MATCHES "dll name:[ \t]*(lib)?flac([-._0-9]+)?\\.dll")
               set(FLACCD_STATIC_FLAC_LINKS FALSE)
            endif()
            string(APPEND probeLog "\nPE inspection:\n${imports}\n${inspectionError}")
         endif()
         file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/FlacCDFlacProbe.log" "${probeLog}")
         if(FLACCD_STATIC_FLAC_LINKS)
            target_link_libraries(flaccd-flac INTERFACE flaccd-flac-static)
            set(flacLinkage static PARENT_SCOPE)
            set(staticFlacArchive "${archive}" PARENT_SCOPE)
            set(selected TRUE)
            message(STATUS "FLAC: verified static archive ${archive} (decoder/encoder/metadata link probe)")
         else()
            message(WARNING "Static FLAC/dependencies did not link with this toolchain; using shared FLAC. See CMakeFiles/FlacCDFlacProbe.log; deploy/package will bundle required DLLs")
         endif()
      else()
         message(STATUS "Static libFLAC.a unavailable in target pkg-config directories; deploy/package will bundle shared FLAC")
      endif()
   endif()
   if(NOT selected)
      target_link_libraries(flaccd-flac INTERFACE PkgConfig::FLAC)
   endif()
endfunction()
