cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED configFile OR NOT EXISTS "${configFile}")
   message(FATAL_ERROR "Pass -DconfigFile=<generated WindowsDeploy-CONFIG.cmake>")
endif()
include("${configFile}")
include("${CMAKE_CURRENT_LIST_DIR}/PeDependencies.cmake")
if(NOT deployExecutables OR NOT deployBase)
   message(FATAL_ERROR "Deployment configuration is incomplete")
endif()
set(deployDirectory "${deployBase}/FlacCD")
set(stageDirectory "${deployBase}/.FlacCD-stage")
set(markerText "FlacCD Windows deployment v1\n")

function(requireManagedDirectory directory)
   if(IS_SYMLINK "${directory}")
      message(FATAL_ERROR "Refusing symlink deployment directory: ${directory}")
   endif()
   if(EXISTS "${directory}")
      if(NOT EXISTS "${directory}/.FlacCD-deployment")
         message(FATAL_ERROR "Refusing to replace unowned deployment directory: ${directory}")
      endif()
      file(READ "${directory}/.FlacCD-deployment" marker)
      if(NOT marker STREQUAL markerText)
         message(FATAL_ERROR "Invalid deployment ownership marker: ${directory}")
      endif()
   endif()
endfunction()

function(auditDeployment directory)
   requireManagedDirectory("${directory}")
   set(executables "")
   foreach(path IN LISTS deployExecutables)
      get_filename_component(base "${path}" NAME)
      list(APPEND executables "${directory}/${base}")
   endforeach()
   set(extraPeRoots "")
   file(GLOB entries LIST_DIRECTORIES FALSE "${directory}/*")
   foreach(entry IN LISTS entries)
      get_filename_component(name "${entry}" NAME)
      string(TOLOWER "${name}" lower)
      if(lower MATCHES "\\.dll$")
         isWindowsSystemDll("${lower}" system)
         if(system)
            message(FATAL_ERROR "Windows system DLL must not be bundled: ${entry}")
         endif()
         list(APPEND extraPeRoots "${entry}")
      endif()
   endforeach()
   # Deliberately exclude build/dependency directories and ambient PATH. A
   # missing transitive DLL must fail even when MSYS2 can supply it locally.
   scanPeClosure("${executables}" "${directory}" "${directory}/imports" closure)
   file(COPY "${directory}/imports/RuntimeDependencies.txt" DESTINATION "${directory}")
endfunction()

file(MAKE_DIRECTORY "${deployBase}")
file(LOCK "${deployBase}/Deployment.lock" GUARD PROCESS TIMEOUT 60)

if(deployMode STREQUAL "verify" OR deployMode STREQUAL "package")
   if(NOT IS_DIRECTORY "${deployDirectory}")
      message(FATAL_ERROR "Build target flaccd-deploy first")
   endif()
   auditDeployment("${deployDirectory}")
   if(deployMode STREQUAL "package")
      execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${archiveName}.partial" --format=zip FlacCD
                      WORKING_DIRECTORY "${deployBase}" RESULT_VARIABLE archived)
      if(NOT archived EQUAL 0)
         message(FATAL_ERROR "ZIP creation failed; no completed archive published")
      endif()
      file(RENAME "${deployBase}/${archiveName}.partial" "${deployBase}/${archiveName}")
      message(STATUS "Windows ZIP: ${deployBase}/${archiveName}")
   endif()
   return()
endif()

requireManagedDirectory("${stageDirectory}")
requireManagedDirectory("${deployDirectory}")
if(EXISTS "${stageDirectory}")
   file(REMOVE_RECURSE "${stageDirectory}")
endif()
file(MAKE_DIRECTORY "${stageDirectory}")
file(WRITE "${stageDirectory}/.FlacCD-deployment" "${markerText}")
if(appVersion)
   file(WRITE "${stageDirectory}/BuildVersion.txt" "${appVersion}\n")
endif()
scanPeClosure("${deployExecutables}" "${runtimeDirs}" "${stageDirectory}/source-imports" dllNames)
foreach(path IN LISTS deployExecutables)
   file(COPY "${path}" DESTINATION "${stageDirectory}")
endforeach()
set(origins "Bundled DLL origins (build-host paths; hashes/imports in RuntimeDependencies.txt):\n")
foreach(name IN LISTS dllNames)
   get_property(path GLOBAL PROPERTY "flaccdDllPath_${name}")
   # Preserve the imported name even when the source is a symlink/alias.
   configure_file("${path}" "${stageDirectory}/${name}" COPYONLY)
   string(APPEND origins "${name} <- ${path}\n")
endforeach()
file(WRITE "${stageDirectory}/RuntimeOrigins.txt" "${origins}")
set(policy "FLAC linkage: ${flacLinkage}\nStatic FLAC archive: ${staticFlacArchive}\nWindows runtime link policy:\n  runtime family: ${runtimeFamily}\n  static compiler/C++ runtime requested: ${expectStaticRuntime}\n  static winpthreads selected: ${expectStaticPthread}\n  static archive: ${staticPthreadArchive}\nShared third-party DLLs can still require GCC/winpthreads transitively; see the audited graph.\nWindows system DLLs and API-set contracts are supplied by Windows 10/11, not bundled.\nImgDrive is a separate external application, not bundled.\n")
file(WRITE "${stageDirectory}/RuntimePolicy.txt" "${policy}")
set(licenseIndex 0)
foreach(directory IN LISTS licenseDirs)
   if(NOT IS_DIRECTORY "${directory}")
      message(FATAL_ERROR "Configured license directory does not exist: ${directory}")
   endif()
   math(EXPR licenseIndex "${licenseIndex} + 1")
   get_filename_component(name "${directory}" NAME)
   file(COPY "${directory}/" DESTINATION "${stageDirectory}/licenses/${licenseIndex}-${name}")
endforeach()
if(sourceRoot AND EXISTS "${sourceRoot}/docs/WindowsDeployment.md")
   file(COPY "${sourceRoot}/docs/WindowsDeployment.md" DESTINATION "${stageDirectory}/docs")
   file(COPY "${sourceRoot}/docs/WindowsAgentTesting.md" DESTINATION "${stageDirectory}/docs")
   file(COPY "${sourceRoot}/docs/MountRecovery.md" DESTINATION "${stageDirectory}/docs")
   file(COPY "${sourceRoot}/docs/WindowsInstaller.md" DESTINATION "${stageDirectory}/docs")
   file(COPY "${sourceRoot}/docs/WindowsCrossCompilation.md" DESTINATION "${stageDirectory}/docs")
   file(COPY "${sourceRoot}/docs/LinuxWindowsRelease.md" DESTINATION "${stageDirectory}/docs")
   file(COPY "${sourceRoot}/docs/WindowsShellTesting.md" DESTINATION "${stageDirectory}/docs")
endif()
auditDeployment("${stageDirectory}")
# Publish only after both the source closure and isolated adjacent-DLL closure
# succeed. Prior complete output remains intact on failed preparation/audits.
if(EXISTS "${deployDirectory}")
   file(REMOVE_RECURSE "${deployDirectory}")
endif()
file(RENAME "${stageDirectory}" "${deployDirectory}")
message(STATUS "Audited Windows deployment: ${deployDirectory}")
