cmake_minimum_required(VERSION 3.20)
include("${sourceRoot}/cmake/PeDependencies.cmake")

function(run)
   execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE problem)
   if(NOT result EQUAL 0)
      message(FATAL_ERROR "Fixture command failed (${ARGV}): ${output} ${problem}")
   endif()
endfunction()

function(makeObject name symbol called bits)
   set(assembly ".text\n.global ${symbol}\n${symbol}:\n")
   if(called)
      string(APPEND assembly " call *__imp_${called}(%rip)\n")
   endif()
   string(APPEND assembly " ret\n")
   file(WRITE "${root}/${name}.s" "${assembly}")
   run("${assembler}" "--${bits}" -o "${root}/${name}.host.o" "${root}/${name}.s")
   if(bits EQUAL 64)
      set(format pe-x86-64)
   else()
      set(format pe-i386)
   endif()
   run("${objcopy}" -O "${format}" "${root}/${name}.host.o" "${root}/${name}.o")
endfunction()

function(writeConfiguration)
   file(WRITE "${configFile}" "set(peObjdump [==[${peObjdump}]==])\nset(deployExecutables [==[${executables}]==])\nset(runtimeDirs [==[${directories}]==])\nset(deployBase [==[${deployBase}]==])\nset(archiveName FlacCD-test.zip)\nset(expectStaticRuntime TRUE)\nset(expectStaticPthread FALSE)\nset(expectStaticFlac ${expectStaticFlac})\nset(sourceRoot [==[${sourceRoot}]==])\n")
endfunction()

function(deploy mode expected)
   execute_process(COMMAND "${CMAKE_COMMAND}" "-DconfigFile=${configFile}" "-DdeployMode=${mode}"
                           -P "${sourceRoot}/cmake/DeployWindows.cmake"
                   RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE problem)
   if(expected STREQUAL "success")
      if(NOT result EQUAL 0)
         message(FATAL_ERROR "Deploy ${mode} failed: ${output} ${problem}")
      endif()
   else()
      if(result EQUAL 0 OR NOT "${output}${problem}" MATCHES "${expected}")
         message(FATAL_ERROR "Expected ${expected}, got (${result}): ${output} ${problem}")
      endif()
   endif()
endfunction()

set(root "${testDirectory}/PE deployment fixtures")
file(MAKE_DIRECTORY "${root}/runtime" "${root}/system" "${root}/input")
set(runtime "${root}/runtime")
set(configFile "${root}/DeployConfig.cmake")
set(deployBase "${root}/output")
set(directories "${runtime}")
set(expectStaticFlac FALSE)
makeObject(system GetTickCount64 "" 64)
run("${linker}" -mi386pep --dll --entry GetTickCount64 --export-all-symbols
    --out-implib "${root}/kernel.a" -o "${root}/system/KERNEL32.dll" "${root}/system.o")
makeObject(gcc gccLeaf GetTickCount64 64)
run("${linker}" -mi386pep --dll --entry gccLeaf --export-all-symbols
    --out-implib "${root}/gcc.a" -o "${runtime}/libgcc_s_seh-1.dll" "${root}/gcc.o" "${root}/kernel.a")
makeObject(pthread leaf gccLeaf 64)
run("${linker}" -mi386pep --dll --entry leaf --export-all-symbols
    --out-implib "${root}/pthread.a" -o "${runtime}/libwinpthread-1.dll" "${root}/pthread.o" "${root}/gcc.a")
makeObject(flac flac leaf 64)
run("${linker}" -mi386pep --dll --entry flac --export-all-symbols
    --out-implib "${root}/flac.a" -o "${runtime}/LibFLAC.DLL" "${root}/flac.o" "${root}/pthread.a")
file(WRITE "${root}/forward.def" "EXPORTS\nforward=LibFLAC.flac\n")
run("${linker}" -mi386pep --dll --entry GetTickCount64 --out-implib "${root}/forward.a"
    -o "${runtime}/forward.dll" "${root}/system.o" "${root}/forward.def")
makeObject(main mainCRTStartup forward 64)
run("${linker}" -mi386pep --entry mainCRTStartup -o "${root}/input/flaccd.exe" "${root}/main.o" "${root}/forward.a")
set(executables "${root}/input/flaccd.exe")
foreach(name flaccd-agent flaccd-info flaccd-export flaccd-bin-cue)
   configure_file("${root}/input/flaccd.exe" "${root}/input/${name}.exe" COPYONLY)
   list(APPEND executables "${root}/input/${name}.exe")
endforeach()
foreach(name kernel32.dll UCRTBASE.dll api-ms-win-crt-runtime-l1-1-0.dll)
   isWindowsSystemDll("${name}" system)
   if(NOT system)
      message(FATAL_ERROR "System classification failed: ${name}")
   endif()
endforeach()
foreach(name libgcc_s_seh-1.dll libstdc++-6.dll libwinpthread-1.dll libFLAC.dll vcruntime140.dll)
   isWindowsSystemDll("${name}" system)
   if(system)
      message(FATAL_ERROR "Redistributable incorrectly treated as OS DLL: ${name}")
   endif()
endforeach()
writeConfiguration()
deploy("" success)
set(output "${deployBase}/FlacCD")
foreach(name flaccd.exe flaccd-agent.exe flaccd-info.exe flaccd-export.exe flaccd-bin-cue.exe
             forward.dll libflac.dll libwinpthread-1.dll libgcc_s_seh-1.dll RuntimeDependencies.txt)
   if(NOT EXISTS "${output}/${name}")
      message(FATAL_ERROR "Deployment missing ${name}")
   endif()
endforeach()
if(EXISTS "${output}/KERNEL32.dll")
   message(FATAL_ERROR "Bundled a Windows system DLL")
endif()
file(READ "${output}/RuntimeDependencies.txt" report)
if(NOT report MATCHES "system: kernel32.dll" OR NOT report MATCHES "bundled: libwinpthread-1.dll")
   message(FATAL_ERROR "Recursive import report incomplete")
endif()
file(SHA256 "${output}/flaccd.exe" originalHash)
set(expectStaticFlac TRUE)
writeConfiguration()
deploy("" "Static FLAC policy not satisfied")
set(expectStaticFlac FALSE)
writeConfiguration()
# A transitive omission cannot be masked by the source dependency directory.
file(REMOVE "${output}/libgcc_s_seh-1.dll")
deploy(verify "Unresolved non-system DLL libgcc_s_seh-1.dll")
deploy("" success)
# Missing source DLL must fail, preserving the prior complete deployment.
file(RENAME "${runtime}/libgcc_s_seh-1.dll" "${runtime}/hidden-gcc")
deploy("" "Unresolved non-system DLL libgcc_s_seh-1.dll")
file(SHA256 "${output}/flaccd.exe" afterHash)
if(NOT afterHash STREQUAL originalHash OR NOT EXISTS "${output}/libgcc_s_seh-1.dll")
   message(FATAL_ERROR "Failed deployment damaged the prior completed output")
endif()
file(RENAME "${runtime}/hidden-gcc" "${runtime}/libgcc_s_seh-1.dll")
# Identical duplicate DLLs are harmless; conflicting toolchain copies are not.
file(MAKE_DIRECTORY "${root}/other")
configure_file("${runtime}/libgcc_s_seh-1.dll" "${root}/other/libgcc_s_seh-1.dll" COPYONLY)
list(APPEND directories "${root}/other")
writeConfiguration()
deploy("" success)
file(APPEND "${root}/other/libgcc_s_seh-1.dll" "different overlay")
deploy("" "Conflicting DLL copies")
set(directories "${runtime}")
writeConfiguration()
# A genuine PE32 DLL is rejected inside the PE32+ closure.
makeObject(wrong _wrong "" 32)
run("${linker}" -mi386pe --dll --entry _wrong --export-all-symbols -o "${root}/wrong.dll" "${root}/wrong.o")
file(RENAME "${runtime}/libgcc_s_seh-1.dll" "${runtime}/saved-gcc")
configure_file("${root}/wrong.dll" "${runtime}/libgcc_s_seh-1.dll" COPYONLY)
deploy("" "PE architecture mismatch")
file(REMOVE "${runtime}/libgcc_s_seh-1.dll")
file(RENAME "${runtime}/saved-gcc" "${runtime}/libgcc_s_seh-1.dll")
# Static policy is enforced on applications, but shared third-party DLLs may
# still import redistributable runtimes, as the synthetic closure demonstrates.
makeObject(direct mainCRTStartup gccLeaf 64)
run("${linker}" -mi386pep --entry mainCRTStartup -o "${root}/direct.exe" "${root}/direct.o" "${root}/gcc.a")
set(savedExecutables "${executables}")
set(executables "${root}/direct.exe")
writeConfiguration()
deploy("" "Static GCC/C[+][+] runtime policy not satisfied")
set(executables "${savedExecutables}")
writeConfiguration()
deploy("" success)
deploy(verify success)
deploy(package success)
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${deployBase}/FlacCD-test.zip"
                RESULT_VARIABLE listed OUTPUT_VARIABLE archiveEntries)
if(NOT listed EQUAL 0 OR NOT archiveEntries MATCHES "FlacCD/flaccd-agent.exe" OR
   NOT archiveEntries MATCHES "FlacCD/libgcc_s_seh-1.dll")
   message(FATAL_ERROR "ZIP is missing application/transitive runtime files")
endif()
configure_file("${root}/system/KERNEL32.dll" "${output}/kernel32.dll" COPYONLY)
deploy(verify "system DLL must not be bundled")
file(REMOVE "${output}/kernel32.dll")
# Refuse replacement of an unowned directory, even within a build tree.
set(deployBase "${root}/unowned-output")
file(MAKE_DIRECTORY "${deployBase}/FlacCD")
file(WRITE "${deployBase}/FlacCD/user.txt" "keep")
writeConfiguration()
deploy("" "unowned deployment directory")
message(STATUS "Real PE deployment tests passed: transitive/forwarded imports, isolation, conflicts, architecture, packaging, ownership")

