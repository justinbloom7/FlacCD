set(input "${fixtureDirectory}/fixture-4096.flac")
set(original "${fixtureDirectory}/original.raw")
set(destination "${fixtureDirectory}/modern-export")
file(REMOVE_RECURSE "${destination}")
file(MAKE_DIRECTORY "${destination}")

function(succeed)
   execute_process(COMMAND "${exportTool}" ${ARGN}
      RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
   if(NOT status EQUAL 0)
      message(FATAL_ERROR "Export failed (${ARGN}): ${output} ${error}")
   endif()
endfunction()

function(reject)
   execute_process(COMMAND "${exportTool}" ${ARGN}
      RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
   if(status EQUAL 0)
      message(FATAL_ERROR "Unexpected export success: ${ARGN}")
   endif()
endfunction()

function(compareRange path first count)
   math(EXPR byteOffset "${first} * 2352")
   math(EXPR byteCount "${count} * 2352")
   file(SIZE "${path}" actualSize)
   if(NOT actualSize EQUAL byteCount)
      message(FATAL_ERROR "Unexpected sector count in ${path}")
   endif()
   file(READ "${original}" expected OFFSET ${byteOffset} LIMIT ${byteCount} HEX)
   file(READ "${path}" actual HEX)
   if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "PCM mismatch in ${path}")
   endif()
endfunction()

succeed("${input}" --all --format raw --output "${destination}/all.raw")
compareRange("${destination}/all.raw" 0 240)
succeed("${input}" --all --format bin-cue --output "${destination}/Disc with spaces & brackets [1]")
compareRange("${destination}/Disc with spaces & brackets [1].bin" 0 240)
file(READ "${destination}/Disc with spaces & brackets [1].cue" cue)
if(NOT cue MATCHES "INDEX 01 00:00:02" OR NOT cue MATCHES "FLAGS PRE DCP")
   message(FATAL_ERROR "CUE shifted INDEX 01 or lost known text flags during auto selection")
endif()
foreach(layout IN ITEMS native text auto)
   succeed("${input}" --all --layout "${layout}" --output "${destination}/${layout}.raw")
   compareRange("${destination}/${layout}.raw" 0 240)
endforeach()
succeed("${input}" --track 1 --output "${destination}/first.raw")
compareRange("${destination}/first.raw" 0 25)
succeed("${input}" --track 2 --output "${destination}/second.raw")
compareRange("${destination}/second.raw" 25 35)
succeed("${input}" --track 2 --index01-only --output "${destination}/second-index01.raw")
compareRange("${destination}/second-index01.raw" 28 32)
succeed("${input}" --track 3 --output "${destination}/last.raw")
compareRange("${destination}/last.raw" 60 180)
succeed("${input}" --tracks 1-2 --output "${destination}/range.raw")
compareRange("${destination}/range.raw" 0 60)
succeed("${input}" --tracks 1-2 --index01-only --output "${destination}/range-index01.raw")
file(READ "${original}" first OFFSET 4704 LIMIT 54096 HEX)
file(READ "${original}" second OFFSET 65856 LIMIT 75264 HEX)
file(READ "${destination}/range-index01.raw" actual HEX)
if(NOT actual STREQUAL "${first}${second}")
   message(FATAL_ERROR "INDEX 01-only range did not omit each selected track's pregap")
endif()
succeed("${input}" --split-tracks --output-dir "${destination}/split")
compareRange("${destination}/split/Track01.raw" 0 25)
compareRange("${destination}/split/Track02.raw" 25 35)
compareRange("${destination}/split/Track03.raw" 60 180)
succeed("${input}" --split-tracks --index01-only --output-dir "${destination}/split-index01")
compareRange("${destination}/split-index01/Track01.raw" 2 23)
compareRange("${destination}/split-index01/Track02.raw" 28 32)
compareRange("${destination}/split-index01/Track03.raw" 60 180)

# LBA-0 CUE-only contract: valid source has no negative first-track audio.
set(noFirstPregap "${fixtureDirectory}/fixture-no-first-pregap.flac")
succeed("${noFirstPregap}" --cue-only --layout text --output "${destination}/cue-only.cue" --bin-file "External disc.bin")
file(READ "${destination}/cue-only.cue" cue)
if(NOT cue MATCHES "FILE \"External disc.bin\" BINARY" OR NOT cue MATCHES "INDEX 01 00:00:00")
   message(FATAL_ERROR "CUE-only reference or timestamps differ")
endif()
if(EXISTS "${destination}/External disc.bin")
   message(FATAL_ERROR "CUE-only unexpectedly generated BIN")
endif()
reject("${input}" --cue-only --output "${destination}/bad.cue" --bin-file "No pregap.bin")
reject("${noFirstPregap}" --all --output "${destination}/conflict.raw")
reject("${noFirstPregap}" --cue-only --layout text --output "${destination}/bad.cue" --bin-file "bad\"name.bin")
reject("${noFirstPregap}" --cue-only --layout text --output "${destination}/bad.cue" --bin-file "../other.bin")
file(WRITE "${destination}/short.bin" "short")
reject("${noFirstPregap}" --cue-only --layout text --output "${destination}/bad.cue" --bin-file short.bin)

# All destinations are preflighted before decoding or publication.
file(MAKE_DIRECTORY "${destination}/blocked-split")
file(WRITE "${destination}/blocked-split/Track03.raw" "Keep me")
reject("${input}" --split-tracks --output-dir "${destination}/blocked-split")
if(EXISTS "${destination}/blocked-split/Track01.raw" OR EXISTS "${destination}/blocked-split/Track02.raw")
   message(FATAL_ERROR "Split preflight failure published audio")
endif()
reject("${input}" --all --output "${destination}/all.raw")
succeed("${input}" --track 2 --overwrite --output "${destination}/all.raw")
compareRange("${destination}/all.raw" 25 35)
file(SHA256 "${input}" before)
reject("${input}" --all --overwrite --output "${input}")
file(SHA256 "${input}" after)
if(NOT before STREQUAL after)
   message(FATAL_ERROR "Overwrite changed input audio")
endif()
succeed("${input}" --all --format bin-cue --overwrite --output "${destination}/Disc with spaces & brackets [1]")

foreach(track IN ITEMS 0 4 99 4294967295)
   reject("${input}" --track "${track}" --output "${destination}/invalid.raw")
endforeach()
reject("${input}" --tracks 3-2 --output "${destination}/invalid.raw")
reject("${input}" --tracks 1-4 --output "${destination}/invalid.raw")
reject("${input}" --all --index01-only --output "${destination}/invalid.raw")
reject("${input}" --track 2 --format bin-cue --output "${destination}/invalid")
reject("${input}" --all --track 2 --output "${destination}/invalid.raw")
reject("${input}" --all --format wav --output "${destination}/invalid.wav")
reject("${input}" --all --layout invalid --output "${destination}/invalid.raw")
reject("${input}" --all --output "${destination}/missing-directory/invalid.raw")
reject("${input}" --all --unknown --output "${destination}/invalid.raw")
reject("${input}" --all --output "${destination}/invalid.raw" --output another.raw)
reject("${input}" --all --output)
set(gap "${fixtureDirectory}/fixture-gap.flac")
reject("${gap}" --all --layout text --output "${destination}/invalid.raw")
reject("${gap}" --all --layout text --format bin-cue --output "${destination}/invalid")
reject("${gap}" --split-tracks --layout text --output-dir "${destination}/gap-split")
reject("${fixtureDirectory}/unsupported-0.flac" --all --output "${destination}/invalid.raw")
reject("${fixtureDirectory}/truncated.flac" --all --overwrite --output "${destination}/all.raw")
compareRange("${destination}/all.raw" 25 35)
if(EXISTS "${destination}/invalid.raw" OR EXISTS "${destination}/invalid.bin" OR EXISTS "${destination}/invalid.cue")
   message(FATAL_ERROR "Rejected export left final-looking files")
endif()
file(GLOB leftovers "${destination}/.flaccd-export-*")
if(leftovers)
   message(FATAL_ERROR "Handled failure left staging files: ${leftovers}")
endif()
if(flacTool)
   execute_process(COMMAND "${flacTool}" --decode --force-raw-format --endian=little --sign=signed
      --silent --force --output-name=${destination}/reference.raw "${input}" RESULT_VARIABLE status)
   if(NOT status EQUAL 0)
      message(FATAL_ERROR "Reference FLAC decode failed")
   endif()
   file(SHA256 "${destination}/reference.raw" referenceHash)
   file(SHA256 "${destination}/Disc with spaces & brackets [1].bin" binHash)
   if(NOT referenceHash STREQUAL binHash)
      message(FATAL_ERROR "Full BIN differs from trusted FLAC decode")
   endif()
endif()
