set(outputDirectory "${fixtureDirectory}/bin-cue-cli")
file(MAKE_DIRECTORY "${outputDirectory}")
file(REMOVE "${outputDirectory}/disc.cue" "${outputDirectory}/disc.bin")
execute_process(COMMAND "${binCueTool}" "${fixtureDirectory}/fixture-4096.flac" text "${outputDirectory}/disc.cue"
   RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
   message(FATAL_ERROR "BIN/CUE CLI failed: ${output} ${error}")
endif()
file(SHA256 "${outputDirectory}/disc.bin" actualHash)
file(SHA256 "${fixtureDirectory}/original.raw" expectedHash)
if(NOT actualHash STREQUAL expectedHash)
   message(FATAL_ERROR "BIN does not match original source PCM")
endif()
execute_process(COMMAND "${binCueTool}" "${fixtureDirectory}/fixture-4096.flac" native "${outputDirectory}/disc.cue"
   RESULT_VARIABLE result)
if(result EQUAL 0)
   message(FATAL_ERROR "CLI overwrote existing outputs")
endif()
execute_process(COMMAND "${binCueTool}" "${fixtureDirectory}/fixture-4096.flac" invalid "${outputDirectory}/other.cue"
   RESULT_VARIABLE result)
if(result EQUAL 0)
   message(FATAL_ERROR "CLI accepted invalid layout selection")
endif()
execute_process(COMMAND "${binCueTool}" RESULT_VARIABLE result)
if(NOT result EQUAL 2)
   message(FATAL_ERROR "CLI argument usage status differs")
endif()
