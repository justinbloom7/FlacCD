cmake_minimum_required(VERSION 3.20)
set(root "${testDirectory}/Payload with spaces")
file(MAKE_DIRECTORY "${root}/docs")
file(WRITE "${root}/flaccd.exe" "fixture")
file(WRITE "${root}/runtime.dll" "fixture")
file(WRITE "${root}/docs/WindowsInstaller.md" "fixture")
file(WRITE "${testDirectory}/Validate.cmake"
   "cmake_minimum_required(VERSION 3.20)\ninclude([==[${sourceRoot}/cmake/InstallerPayload.cmake]==])\nvalidateInstallerPayload([==[${root}]==] flaccd.exe)\n")

function(validate expected)
   execute_process(COMMAND "${CMAKE_COMMAND}" -P "${testDirectory}/Validate.cmake"
                   RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
   if(expected STREQUAL "success")
      if(NOT result EQUAL 0)
         message(FATAL_ERROR "Valid installer payload rejected: ${output}${error}")
      endif()
   elseif(result EQUAL 0 OR NOT "${output}${error}" MATCHES "${expected}")
      message(FATAL_ERROR "Expected ${expected}, received ${result}: ${output}${error}")
   endif()
endfunction()

validate(success)
foreach(name gcc.exe ImgDrive.exe driver.sys library.a helper.cmd docs/nested.dll)
   file(WRITE "${root}/${name}" "unexpected")
   validate("Unexpected installer executable|Development/driver/nested runtime")
   file(REMOVE "${root}/${name}")
endforeach()
file(REMOVE "${root}/flaccd.exe")
validate("Missing installer executable")
file(WRITE "${root}/flaccd.exe" "fixture")
file(REMOVE "${root}/docs/WindowsInstaller.md")
validate("Installer usage documentation is missing")
file(WRITE "${root}/docs/WindowsInstaller.md" "fixture")
message(STATUS "Installer payload inclusion/exclusion checks passed")
include("${sourceRoot}/cmake/InstalledBinaries.cmake")
file(WRITE "${root}/keep user data.txt" "unrelated")
file(WRITE "${root}/OlderRuntime.DLL" "old runtime")
writeInstalledBinaries("${root}" "${testDirectory}/BinaryManifest.txt")
file(READ "${testDirectory}/BinaryManifest.txt" manifest)
file(SHA256 "${root}/OlderRuntime.DLL" expectedHash)
if(NOT manifest MATCHES "OlderRuntime.DLL\\|${expectedHash}" OR manifest MATCHES "keep user data")
   message(FATAL_ERROR "Upgrade manifest omitted a runtime hash or claimed user data")
endif()
file(WRITE "${root}/OlderRuntime.DLL" "modified")
file(SHA256 "${root}/OlderRuntime.DLL" modifiedHash)
if(modifiedHash STREQUAL expectedHash)
   message(FATAL_ERROR "Modified obsolete binary cannot be distinguished")
endif()
file(REMOVE "${root}/OlderRuntime.DLL")
writeInstalledBinaries("${root}" "${testDirectory}/NewBinaryManifest.txt")
file(READ "${testDirectory}/NewBinaryManifest.txt" newManifest)
if(newManifest MATCHES "OlderRuntime")
   message(FATAL_ERROR "New binary manifest retained removed runtime")
endif()
file(READ "${sourceRoot}/installer/FlacCD.iss" installer)
if(NOT installer MATCHES "AppId=\\{\\{70A8B7A2-BE27-4D88-9566-76E87C57F284\\}" OR
   NOT installer MATCHES "UsePreviousAppDir=yes" OR NOT installer MATCHES "UninstallLogMode=append" OR
   installer MATCHES "\\[UninstallDelete\\]|\\[Registry\\]")
   message(FATAL_ERROR "Installer lost its stable in-place upgrade/CLI registry contract")
endif()
